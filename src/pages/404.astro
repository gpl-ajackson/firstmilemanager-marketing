---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Page not found" description="This page could not be found." noindex>
  <PageHeader eyebrow="404" title="We can’t find that page" lead="It may have moved, or the link may be wrong.">
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go to the home page</a>
    </div>
  </PageHeader>
</Base>
