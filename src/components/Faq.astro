---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = 'Questions' } = Astro.props;

// FAQPage structured data is added by the page through Base's schema prop, using faqSchema().
---

<section class="container-page mt-20" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-3xl font-bold tracking-tight">{heading}</h2>
  <div class="mt-8 divide-y divide-line border-y border-line">
    {
      items.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {item.question}
            <span aria-hidden="true" class="mt-1 text-brand-strong transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 max-w-3xl text-ink-soft">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
