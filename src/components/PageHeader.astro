---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="container-page pb-10 pt-10 sm:pt-14">
  <div class="max-w-3xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 text-lg text-ink-soft text-pretty sm:text-xl">{lead}</p>}
    <slot />
  </div>
</section>
