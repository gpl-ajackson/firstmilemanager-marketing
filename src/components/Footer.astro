---
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'First Mile Manager',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Early access', href: '/early-access' },
      ...(site.demo.live ? [{ label: 'Try the demo', href: site.demo.url }] : []),
      ...(site.helpUrl ? [{ label: 'Help centre', href: site.helpUrl }] : []),
      ...(site.signInUrl ? [{ label: 'Sign in', href: site.signInUrl }] : []),
      { label: 'Contact', href: `mailto:${site.email}` },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy notice', href: '/privacy' },
      { label: 'Cookies', href: '/cookies' },
      { label: 'Website terms', href: '/terms' },
      { label: 'Accessibility', href: '/accessibility' },
    ],
  },
];
---

<footer class="mt-24 border-t border-line bg-wash">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[2fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-4 text-sm text-muted">
        Software for small couriers and hauliers that collect from local businesses. Now in early access.
      </p>
    </div>
    {
      columns.map((column) => (
        <div>
          <h2 class="text-sm font-semibold text-ink">{column.heading}</h2>
          <ul class="mt-3 space-y-2 text-sm text-ink-soft">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line">
    <div class="container-page space-y-1 py-6 text-xs text-muted">
      <p>© {year} {site.company.legalName}, trading as {site.company.tradingName}. {site.name} is made in the UK.</p>
      <p>
        Registered in {site.company.registeredIn}, company number {site.company.number}. Registered office:{' '}
        {site.company.address.street}, {site.company.address.town}, {site.company.address.county}, {site.company.address.postcode}.
      </p>
    </div>
  </div>
</footer>
