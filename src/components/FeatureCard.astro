---
import StatusBadge from './StatusBadge.astro';
import { guideUrl, type FeatureArea } from '../data/features';

interface Props {
  feature: FeatureArea;
  showPoints?: boolean;
  /** Link to the feature's guide in the help centre, when it has one (see guideUrl). */
  showGuide?: boolean;
}

const { feature, showPoints = false, showGuide = false } = Astro.props;
const guide = showGuide ? guideUrl(feature) : null;
---

<article class="flex h-full flex-col rounded-xl border border-line bg-paper p-6">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class="text-lg font-semibold">{feature.name}</h3>
    <StatusBadge status={feature.status} />
  </div>
  <p class="mt-3 text-ink-soft">{feature.summary}</p>
  {
    showPoints && (
      <ul class="mt-4 space-y-2 text-sm text-ink-soft">
        {feature.points.map((point) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 bg-ink" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )
  }
  {
    guide ? (
      <p class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-4 text-sm font-semibold">
        {feature.href && (
          <a href={feature.href} class="link">
            More about {feature.name.toLowerCase()}
          </a>
        )}
        <a href={guide} class="link">
          Read the guide<span class="sr-only"> to {feature.name.toLowerCase()}</span>
        </a>
      </p>
    ) : (
      feature.href && (
        <a href={feature.href} class="link mt-auto pt-4 text-sm font-semibold">
          More about {feature.name.toLowerCase()}
        </a>
      )
    )
  }
</article>
