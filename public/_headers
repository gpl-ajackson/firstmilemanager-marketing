# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro fingerprints these file names, so they can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Brand fonts change only with a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
